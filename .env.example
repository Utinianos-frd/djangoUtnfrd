POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Obligatoria. Generar una por entorno, nunca commitearla:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Solo True en desarrollo local (habilita trazas de error y POST /api/v1/dev/seed). Default: False.
DJANGO_DEBUG=False

# Hosts separados por coma (los que llegan en el header Host, ej. el dominio detrás del proxy).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Login con Google: ID de cliente OAuth 2.0 (Google Cloud Console → Clientes).
# Mismo valor que GOOGLE_CLIENT_ID en el frontend. Vacío = login con Google deshabilitado.
GOOGLE_CLIENT_ID=

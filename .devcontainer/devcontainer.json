{
  "name": "utn-frd",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.override.yml"
  ],
  "service": "web",
  "workspaceFolder": "/workspace",
  "remoteUser": "developer",
  "forwardPorts": [8000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "batisteo.vscode-django",
        "wholroyd.jinja",
        "cstrap.flask-snippets",
        "monosans.djlint",
        "njpwerner.autodocstring"
      ]
    }
  }
}